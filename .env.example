# Copy to .env.local for development, and add the same values in Vercel
# under Project Settings → Environment Variables.
#
# The site builds and runs without any of these. The contact form degrades to
# a "reach me directly by email" message until RESEND_API_KEY is present.

# Resend API key — https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Sender address. Must be on a domain you have verified in Resend.
# Until a domain is verified, Resend allows onboarding@resend.dev for testing.
CONTACT_FROM="LBC Innovation <hello@lbcinnovation.com>"

# Inbox that form submissions are delivered to.
# Falls back to `site.email` in src/lib/site.ts when unset.
CONTACT_TO=
